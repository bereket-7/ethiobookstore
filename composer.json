{
  "name": "bereket-7/ethiobookstore",
  "description": "Ethiopian Bookstore — plain PHP storefront",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-mysqli": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "EthioBookstore\\": "bookstore/lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EthioBookstore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
